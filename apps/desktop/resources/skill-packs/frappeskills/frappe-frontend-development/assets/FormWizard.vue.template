<!--
  Multi-step form wizard dialog — targets frappe-ui 1.0.0-beta.29 (v1).
  Replace {{ doctype }} and wire `sections`/`statusOptions` to the real doctype.
  0.1.x (crm/node_modules/frappe-ui 0.1.261) differences:
    - Dialog has no flat props — use `<Dialog v-model :options="{ title, size }">`
      with `#body`/`#actions` slots instead of `v-model:open` + `#default`/`#actions`.
    - No `useNewDoc`/`useDoc` — use `createResource({ type: 'document', doctype })`
      (`.insert`) or a plain `createResource({ url: 'frappe.client.save', ... })`.
-->
<template>
  <Dialog v-model:open="isOpen" :title="formTitle" size="7xl">
    <div class="h-[80vh] flex">
      <!-- Progress sidebar -->
      <div class="w-64 bg-surface-gray-1 border-r border-outline-gray-2 flex-shrink-0 overflow-y-auto">
        <div class="p-4">
          <h4 class="text-sm font-semibold text-ink-gray-9 mb-3">Progress</h4>
          <div class="space-y-2">
            <div
              v-for="(section, index) in sections"
              :key="section.id"
              class="flex items-center gap-2 p-2 rounded-lg cursor-pointer"
              :class="currentSection === index ? 'bg-surface-blue-2' : 'hover:bg-surface-gray-2'"
              @click="goToSection(index)"
            >
              <div
                class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-semibold"
                :class="isSectionComplete(section.id) ? 'bg-surface-green-3 text-white' : 'bg-surface-gray-3 text-ink-gray-6'"
              >
                <span v-if="isSectionComplete(section.id)" class="lucide-check size-3" />
                <span v-else>{{ index + 1 }}</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-ink-gray-9 truncate">{{ section.title }}</div>
                <div class="text-xs text-ink-gray-6 truncate">{{ section.description }}</div>
              </div>
            </div>
          </div>

          <div class="mt-4 p-3 bg-surface-white rounded-lg border border-outline-gray-2">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-medium text-ink-gray-7">Overall Progress</span>
              <span class="text-xs font-semibold text-ink-blue-3">{{ overallProgress }}%</span>
            </div>
            <div class="w-full bg-surface-gray-3 rounded-full h-1.5">
              <div class="bg-surface-blue-3 h-1.5 rounded-full" :style="{ width: `${overallProgress}%` }" />
            </div>
          </div>

          <div v-if="lastSaved" class="mt-3 text-xs text-ink-gray-6 text-center">
            Last saved: {{ lastSaved }}
          </div>
        </div>
      </div>

      <!-- Form content -->
      <div class="flex-1 overflow-y-auto">
        <div class="p-6 space-y-8">
          <div v-for="(section, index) in sections" :key="section.id" v-show="currentSection === index">
            <h2 class="text-lg font-semibold text-ink-gray-9 mb-4">{{ section.title }}</h2>
            <div class="bg-surface-white rounded-lg border border-outline-gray-2 p-6">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <FormControl
                  v-for="field in section.fields"
                  :key="field.fieldname"
                  v-model="form[field.fieldname]"
                  :label="field.label"
                  :placeholder="field.placeholder"
                  :type="field.type || 'text'"
                  :options="field.options"
                />
              </div>
            </div>
          </div>

          <!-- Review -->
          <div v-show="currentSection === sections.length - 1">
            <h2 class="text-lg font-semibold text-ink-gray-9 mb-4">Review & Submit</h2>
            <div class="bg-surface-white rounded-lg border border-outline-gray-2 p-6">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                <div v-for="(value, key) in formSummary" :key="key" class="bg-surface-gray-1 rounded-lg p-4">
                  <p class="text-xs text-ink-gray-6 uppercase">{{ key }}</p>
                  <p class="text-lg font-semibold text-ink-gray-9">{{ value || '-' }}</p>
                </div>
              </div>
              <div class="border-t border-outline-gray-2 pt-4">
                <h5 class="text-sm font-medium text-ink-gray-9 mb-3">Validation Status</h5>
                <div class="space-y-2">
                  <div v-for="check in validationChecks" :key="check.label" class="flex items-center gap-2">
                    <span
                      class="size-5"
                      :class="check.valid ? 'lucide-check-circle-2 text-ink-green-3' : 'lucide-x-circle text-ink-red-3'"
                    />
                    <span class="text-sm" :class="check.valid ? 'text-ink-gray-7' : 'text-ink-red-3'">
                      {{ check.label }}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <template #actions>
      <div class="flex items-center justify-between w-full">
        <Button v-if="currentSection > 0" variant="outline" @click="previousSection">Previous</Button>
        <div class="flex items-center gap-2 ms-auto">
          <Button variant="outline" :loading="saving" @click="saveDraft">Save Draft</Button>
          <Button v-if="currentSection < sections.length - 1" variant="solid" @click="nextSection">
            Next
          </Button>
          <Button
            v-else
            variant="solid"
            :disabled="!isFormValid"
            :loading="submitting"
            @click="submitForm"
          >
            Submit
          </Button>
        </div>
      </div>
    </template>
  </Dialog>
</template>

<script setup>
import { computed, ref, watch } from 'vue'
import { Button, Dialog, FormControl, useDoc, useNewDoc, toast } from 'frappe-ui'

const doctype = '{{ doctype }}'

const props = defineProps({
  open: Boolean,
  item: Object,
  mode: { type: String, default: 'create' }, // 'create' | 'edit'
})

const emit = defineEmits(['update:open', 'saved'])

const currentSection = ref(0)
const saving = ref(false)
const submitting = ref(false)
const lastSaved = ref(null)
const form = ref(getDefaultForm())

const sections = [
  {
    id: 'basic',
    title: 'Basic Information',
    description: 'Enter the basic details',
    fields: [
      { fieldname: 'name', label: 'Name', type: 'text', placeholder: 'Enter name' },
      { fieldname: 'status', label: 'Status', type: 'select', options: ['Active', 'Draft', 'Inactive'] },
    ],
  },
  {
    id: 'details',
    title: 'Additional Details',
    description: 'Provide additional information',
    fields: [
      { fieldname: 'description', label: 'Description', type: 'textarea', placeholder: 'Enter description' },
    ],
  },
]

const isOpen = computed({
  get: () => props.open,
  set: (val) => emit('update:open', val),
})

const formTitle = computed(() => (props.mode === 'edit' ? `Edit ${doctype}` : `New ${doctype}`))

const overallProgress = computed(() => {
  const totalFields = sections.reduce((acc, s) => acc + s.fields.length, 0)
  const filledFields = sections.reduce(
    (acc, s) => acc + s.fields.filter((f) => form.value[f.fieldname]).length,
    0,
  )
  return Math.round((filledFields / totalFields) * 100)
})

const isFormValid = computed(() => !!form.value.name)

const formSummary = computed(() => ({
  Name: form.value.name || '-',
  Status: form.value.status || '-',
  Description: form.value.description || '-',
}))

const validationChecks = computed(() => [
  { label: 'Name is filled', valid: !!form.value.name },
  { label: 'Status is selected', valid: !!form.value.status },
])

function getDefaultForm() {
  return { name: '', status: 'Draft', description: '' }
}

function isSectionComplete(sectionId) {
  const section = sections.find((s) => s.id === sectionId)
  return !!section && section.fields.every((f) => form.value[f.fieldname])
}

function goToSection(index) {
  currentSection.value = index
}

function previousSection() {
  if (currentSection.value > 0) currentSection.value--
}

function nextSection() {
  if (currentSection.value < sections.length - 1) currentSection.value++
}

async function saveDraft() {
  saving.value = true
  try {
    // Persist to local storage / a draft doctype here if needed.
    lastSaved.value = new Date().toLocaleTimeString()
  } finally {
    saving.value = false
  }
}

async function submitForm() {
  submitting.value = true
  try {
    if (props.mode === 'edit' && props.item?.name) {
      const doc = useDoc({ doctype, name: props.item.name, immediate: false })
      await doc.setValue.submit(form.value)
    } else {
      const draft = useNewDoc(doctype, form.value)
      await draft.submit()
    }
    toast.success(props.mode === 'edit' ? 'Updated' : 'Created')
    emit('saved', form.value)
    isOpen.value = false
  } catch (err) {
    toast.error(err.messages?.[0] ?? 'Failed to submit')
  } finally {
    submitting.value = false
  }
}

watch(
  () => props.item,
  (newItem) => {
    form.value = { ...getDefaultForm(), ...newItem }
    currentSection.value = 0
  },
  { immediate: true },
)

watch(
  () => props.open,
  (newOpen) => {
    if (!newOpen) {
      currentSection.value = 0
      lastSaved.value = null
    }
  },
)
</script>
