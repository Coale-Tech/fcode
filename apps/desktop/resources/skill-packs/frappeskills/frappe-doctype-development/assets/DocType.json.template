{
  "doctype": "DocType",
  "name": "{{ doctype }}",
  "module": "{{ module }}",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:title",
  "istable": 0,
  "issingle": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "quick_entry": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nActive\nInactive",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
