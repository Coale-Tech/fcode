{
  "name": "fly",
  "version": "0.1.0",
  "description": "FileBird — a cross-platform desktop SFTP client",
  "desktopName": "fly.desktop",
  "main": "./out/main/main.js",
  "author": "titansoftlimited",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/dev-app-name.mjs",
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:mac": "npm run build && node scripts/prepare-native.mjs darwin && electron-builder --mac",
    "build:mac:share": "npm run build && node scripts/prepare-native.mjs darwin && electron-builder --mac --universal -c.mac.target=dmg",
    "build:win": "npm run build && node scripts/prepare-native.mjs win32 && electron-builder --win",
    "build:linux": "npm run build && node scripts/prepare-native.mjs linux && electron-builder --linux",
    "build:unpack": "npm run build && electron-builder --dir",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-test.mjs",
    "screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/screenshots.mjs",
    "test-server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-server.mjs",
    "verify:package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.2.0-beta.15",
    "ssh2": "^1.17.0"
  }
}
