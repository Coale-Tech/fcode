+ * chrome.css holds the base .nav-rail rules with --d-rail-w (50px).
+ * This section adds: island layout override, icon-only collapsed mode,
+ * expanded (220px) state, canvas island surface, and window-chrome-row
+ * overrides for non-rail layouts.
+ *
+ * Design refs: D.css:322-449 (rail), D.css:451-461 (canvas)
+ */
+
+/* ── Island layout: rail 60px (D3) ── */
+:root[data-nav-layout="island"] .nav-rail {
+  width: var(--d-rail-island);
+  flex: 0 0 var(--d-rail-island);
+}
+:root[data-nav-layout="island"] .app-shell > :where(.app-chat-shell) > .window-chrome-row {
+  left: var(--d-rail-island);
+}
+:root[data-nav-layout="island"] .window-chrome-row.sidebar-expanded {
+  left: calc(var(--d-rail-island) + var(--ds-sidebar-width));
+}
+
+/* ── Tabs layout: no left rail ── */
+:root[data-nav-layout="tabs"] .app-shell > :where(.app-chat-shell) > .window-chrome-row {
+  left: 0;
+}
+:root[data-nav-layout="tabs"] .window-chrome-row.sidebar-expanded {
+  left: var(--ds-sidebar-width);
+}
+
+/* ── D2 rail: labels hidden/animated in collapsed rail mode (D.css:404-414) ── */
+/* opacity/max-width transition matches D.css for smooth expand animation. */
+:root[data-nav-layout="rail"] .nav-rail-label {
+  opacity: 0;
+  max-width: 0;
+  overflow: hidden;
+  transition: opacity .15s, max-width .15s;
+}
+:root[data-nav-layout="rail"] .nav-rail-btn.nav-rail-labeled {
+  /* collapsed: icon box centered (label hidden) */
+  justify-content: center;
+}
+
+/* ── D2 rail: expanded 220px state (D.css:334, 413-414) ── */
+:root[data-nav-layout="rail"] .nav-rail.expanded {
+  width: var(--d-rail-exp);
+  flex: 0 0 var(--d-rail-exp);
+}
+:root[data-nav-layout="rail"] .nav-rail.expanded .nav-rail-label {
+  opacity: 1;
+  max-width: 160px;
+}
+:root[data-nav-layout="rail"] .nav-rail.expanded .nav-rail-btn.nav-rail-labeled {
+  justify-content: flex-start;                  /* icon left, label follows */
+  gap: var(--d-rail-item-gap);                  /* 2px (D.css:413) */
+}
+/* When expanded, align toggle to the left edge */
+:root[data-nav-layout="rail"] .nav-rail.expanded .nav-rail-foot {
+  justify-content: flex-start;
+}
+
+/* ── D2 canvas island (D.css:451-461, D.css:464-481) ── */
+/* app-chat-shell body becomes the gray canvas backdrop */
+:root[data-nav-layout="rail"] .app-chat-shell {
+  background: var(--d-canvas-bg);               /* light: surface-gray-2; dark: surface-base */
+}
+/* main-pane is the elevated glass panel floating on the canvas (D.css:464-474) */
+:root[data-nav-layout="rail"] .main-pane:not(.is-workbench) {
+  margin: var(--d-gap);                         /* all-side 12px gutter (D.css:456) */
+  border-radius: var(--d-r);
+  border: 1px solid var(--outline-elevation-1); /* D.css:471 */
+  box-shadow: var(--elevation-base);            /* D.css:470 — overrides shadow-chat-area */
+}
+/* workbench pages (build/bench) own their own panels; no island wrap */
+:root[data-nav-layout="rail"] .main-pane.is-workbench {
+  margin: 0;
+  border: none;
+  box-shadow: none;
+}
+
+/* ── D2 rail footer: notification+settings+toggle (D.css:432-449) ── */
+.nav-rail-foot {
+  padding: 6px;
+  border-top: 1px solid var(--d-border);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--d-rail-item-gap);                  /* 2px between footer items */
+}
+.nav-rail-toggle {
+  width: var(--d-ctrl);                         /* 28px (D.css:438) */
+  height: var(--d-ctrl);
+  border-radius: var(--d-r-sm);
+  border: none;
+  background: transparent;
+  color: var(--ink-gray-5);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  transition: background .12s;
+}
+.nav-rail-toggle:hover { background: var(--surface-gray-2); color: var(--ink-gray-8); }
